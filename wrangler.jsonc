{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noma",
  "main": "cloudflare/noma-ai-worker.js",
  "compatibility_date": "2026-11-04",
  "keep_vars": true,
  "vars": {
    "QWEN_ENDPOINT": "https://maas.qianwenaiapi.com/compatible-mode/v1/chat/completions",
    "QWEN_MODEL": "qwen3.7-flash",
    "MATTING_ENABLED": "false",
    "AUTH_UNVERIFIED_RETENTION_HOURS": "24",
    "MEDIA_GC_RETENTION_DAYS": "3",
    "SUPABASE_URL": "https://rthvexnnsebtfxcfpung.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_QBCoMyZvh6Px_3AFff_yTg_5BOpG8FY"
  },
  "placement": {
    // Comparison placement: prefer execution near Singapore.
    "region": "aws:ap-southeast-1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "NOMA_MEMORY_IMAGES",
      "bucket_name": "noma-memory-images"
    }
  ],
  "triggers": {
    "crons": ["0 19 * * *"]
  }
}
